PORT=3000

# Conexión a MySQL (docker-compose)
# DATABASE_URL usa el usuario root: lo necesita Prisma CLI para correr migraciones
DATABASE_URL=mysql://root:root@localhost:3306/ecommerce
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce

# La imagen de MySQL la requiere para inicializar el usuario root del contenedor
MYSQL_ROOT_PASSWORD=root

# Usuario no-root que usa la app en runtime (lo crea la imagen automáticamente
# con privilegios solo sobre MYSQL_DATABASE)
MYSQL_USER=user
MYSQL_PASSWORD=pass

# JWT — elegir un string largo y aleatorio para producción
JWT_SECRET=cambiar_esto_por_un_secreto_seguro

# Envío de emails (verificación de cuenta, reset de contraseña) vía Gmail SMTP.
# GMAIL_APP_PASSWORD es un App Password de 16 caracteres (no tu contraseña real),
# requiere verificación en 2 pasos activada en la cuenta de Gmail.
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# URL del frontend, para armar los links que van en los emails
FRONTEND_URL=http://localhost:4200
